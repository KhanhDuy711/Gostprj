# Database (run `docker compose up -d` to start a local Postgres, or point to your own)
DATABASE_URL="postgresql://visualbar:visualbar@localhost:5432/visualbarstore"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand--base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Storage (mock provider by default — writes to ./.storage locally)
STORAGE_PROVIDER="mock"
# Set these when switching STORAGE_PROVIDER to "s3":
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_CDN_URL=""

# Payments (mock provider by default — simulates instant success + signed webhook)
PAYMENT_PROVIDER="mock"
# Set these when switching PAYMENT_PROVIDER to "stripe":
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Signed download URLs
DOWNLOAD_URL_SECRET="replace-with-openssl-rand--base64-32"
DOWNLOAD_URL_TTL_SECONDS="300"
